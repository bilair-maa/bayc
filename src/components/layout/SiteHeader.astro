---
import Button from '../ui/Button.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { applyHref, routes, site, siteNav } from '../../data/site';

// Astro may serve a route with or without a trailing slash.
const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');

// A section's sub-pages (e.g. /about/founder) also mark that section as current.
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
	<div class="container inner">
		<a href={routes.home} class="brand">
			{/* Decorative: the organization name is the link's accessible text. */}
			<img src="/images/bayc-seal.png" alt="" width="56" height="56" />
			<span class="brand-text">
				<span class="brand-name">{site.name}</span>
				<span class="brand-name-bengali" lang="bn">{site.nameBengali}</span>
			</span>
		</a>
		<nav aria-label="Main" class="desktop-nav">
			<ul role="list" class="nav-list">
				{
					siteNav.map((item) => (
						<li>
							<a
								href={item.href}
								class="nav-link"
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<Button href={applyHref} variant="green" size="compact">Join BAYC</Button>
				</li>
			</ul>
		</nav>
		<button
			type="button"
			class="menu-button"
			aria-label="Open menu"
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls="site-menu"
			data-menu-open
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M4 7h16"></path>
				<path d="M4 12h16"></path>
				<path d="M4 17h16"></path>
			</svg>
		</button>
	</div>

	{/* Phones and tablets: the main nav opens as a side sheet. The native <dialog> traps focus, closes on Escape and returns focus to the menu button. */}
	<dialog id="site-menu" class="menu" aria-label="Menu" data-menu>
		<div class="menu-top">
			<img src="/images/bayc-seal.png" alt="" width="44" height="44" />
			<form method="dialog">
				<button type="submit" class="menu-close" aria-label="Close menu">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M6 6l12 12"></path>
						<path d="M18 6L6 18"></path>
					</svg>
				</button>
			</form>
		</div>
		<nav aria-label="Main">
			<ul role="list" class="menu-list">
				{
					siteNav.map((item) => (
						<li>
							<a
								href={item.href}
								class="menu-link"
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="menu-footer">
			<Button href={applyHref} variant="gold">Join BAYC</Button>
			<a href={`mailto:${site.email}`} class="link-on-dark">{site.email}</a>
			<SocialLinks />
		</div>
	</dialog>
</header>

<script>
	const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
	const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
	// Matches the breakpoint where the full nav shows in the header.
	const desktop = window.matchMedia('(min-width: 64rem)');

	if (menu && openButton) {
		openButton.addEventListener('click', () => {
			menu.showModal();
			openButton.setAttribute('aria-expanded', 'true');
		});
		menu.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));
		// A click on the dimmed backdrop (the dialog itself, not its content) closes it.
		menu.addEventListener('click', (event) => {
			if (event.target === menu) menu.close();
		});
		// Links to a section of the current page don't unload it, so the menu closes itself.
		for (const link of menu.querySelectorAll('a')) {
			link.addEventListener('click', () => menu.close());
		}
		desktop.addEventListener('change', (event) => {
			if (event.matches) menu.close();
		});
	}
</script>

<style>
	.site-header {
		background: var(--color-cream);
		border-block-end: 1px solid var(--color-border);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px 40px;
		padding-block: 14px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		min-inline-size: 0;
		color: var(--color-green-800);
		text-decoration: none;
	}

	.brand img {
		flex: none;
		inline-size: 48px;
		block-size: 48px;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.brand-name {
		font-family: var(--font-serif);
		font-size: clamp(1.125rem, 0.9rem + 1vw, var(--text-2xl));
		font-weight: 600;
		line-height: 1.1;
	}

	.brand-name-bengali {
		font-family: var(--font-bengali);
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--color-text-subtle);
	}

	.desktop-nav {
		display: none;
	}

	.nav-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 22px;
		font-size: var(--text-base);
		font-weight: 500;
	}

	.nav-link {
		color: var(--color-ink);
		text-decoration: none;
	}

	.nav-link:hover,
	.nav-link[aria-current='page'] {
		color: var(--color-green-800);
		text-decoration: underline;
		text-decoration-color: var(--color-gold);
		text-underline-offset: 6px;
	}

	.nav-link[aria-current='page'] {
		text-decoration-thickness: 2px;
	}

	.menu-button,
	.menu-close {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: var(--tap-target-lg);
		block-size: var(--tap-target-lg);
		padding: 0;
		background: transparent;
		border: 1px solid var(--color-input-border);
		border-radius: var(--radius);
		color: var(--color-green-800);
		cursor: pointer;
	}

	.menu-button:hover {
		border-color: var(--color-green-800);
		background: color-mix(in srgb, var(--color-green-800) 6%, transparent);
	}

	.menu-button svg,
	.menu-close svg {
		inline-size: 24px;
		block-size: 24px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	@media (min-width: 64rem) {
		.inner {
			flex-wrap: wrap;
			padding-block: 18px;
		}

		.brand {
			gap: 14px;
		}

		.brand img {
			inline-size: 56px;
			block-size: 56px;
		}

		.desktop-nav {
			display: block;
		}

		.menu-button {
			display: none;
		}
	}

	.menu {
		--focus-ring-color: var(--color-gold-light);
		box-sizing: border-box;
		inline-size: min(24rem, 88vw);
		max-inline-size: none;
		block-size: 100dvh;
		max-block-size: none;
		margin: 0;
		margin-inline-start: auto;
		padding: 16px 24px 32px;
		overflow-y: auto;
		background: var(--color-green-950);
		border: 0;
		color: var(--color-on-dark);
	}

	.menu[open] {
		display: flex;
		flex-direction: column;
		gap: 24px;
		animation: menu-in 0.28s cubic-bezier(0.22, 0.7, 0.2, 1);
	}

	.menu::backdrop {
		background: color-mix(in srgb, var(--color-green-950) 60%, transparent);
	}

	.menu[open]::backdrop {
		animation: backdrop-in 0.28s ease;
	}

	@keyframes menu-in {
		from {
			transform: translateX(100%);
		}
	}

	@keyframes backdrop-in {
		from {
			opacity: 0;
		}
	}

	.menu-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.menu-close {
		border-color: color-mix(in srgb, var(--color-cream) 40%, transparent);
		color: var(--color-cream);
	}

	.menu-close:hover {
		background: color-mix(in srgb, var(--color-cream) 8%, transparent);
	}

	.menu-list {
		display: flex;
		flex-direction: column;
	}

	.menu-link {
		display: flex;
		align-items: center;
		gap: 14px;
		min-block-size: 56px;
		padding-block: 8px;
		border-block-end: 1px solid color-mix(in srgb, var(--color-on-dark) 18%, transparent);
		color: var(--color-on-dark);
		font-family: var(--font-serif);
		font-size: var(--text-2xl);
		font-weight: 500;
		text-decoration: none;
	}

	.menu-link:hover {
		color: var(--color-on-dark-strong);
	}

	.menu-link[aria-current='page'] {
		color: var(--color-gold-light);
	}

	/* A gold rule marks the current page alongside its color. */
	.menu-link[aria-current='page']::before {
		content: '';
		flex: none;
		inline-size: 20px;
		block-size: 2px;
		background: var(--color-gold);
	}

	.menu-footer {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
		margin-block-start: auto;
		font-size: var(--text-base);
	}

	.menu-footer :global(.button) {
		align-self: stretch;
	}

	/* Keeps the page behind the open menu from scrolling. */
	:global(html:has(#site-menu[open])) {
		overflow: hidden;
	}

	@media (prefers-reduced-motion: reduce) {
		.menu[open],
		.menu[open]::backdrop {
			animation: none;
		}
	}
</style>
