---
// Copy-link, email, LinkedIn and Facebook sharing for a story or statement.
interface Props {
	title: string;
}

const { title } = Astro.props;
const pageUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(pageUrl);
const shares = [
	{
		label: 'Share by email',
		href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodedUrl}`,
		icon: 'email',
	},
	{
		label: 'Share on LinkedIn',
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
		icon: 'linkedin',
	},
	{
		label: 'Share on Facebook',
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
		icon: 'facebook',
	},
] as const;
---

<div class="share" data-copy-scope>
	<button type="button" class="icon-button" aria-label="Copy link" data-copy="page-url" data-copy-done="Link copied">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"></path>
			<path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"></path>
		</svg>
	</button>
	{
		shares.map((share) => (
			<a href={share.href} class="icon-button" aria-label={share.label}>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					{share.icon === 'email' && (
						<>
							<rect x="3" y="5" width="18" height="14" rx="1.5" />
							<path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
						</>
					)}
					{share.icon === 'linkedin' && (
						<>
							<rect x="3" y="3" width="18" height="18" rx="3" />
							<path d="M8 10.5V17" />
							<path d="M8 7.2v.1" />
							<path d="M12 17v-6.5" />
							<path d="M12 13.5a2.5 2.5 0 0 1 5 0V17" />
						</>
					)}
					{share.icon === 'facebook' && (
						<path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V9H6.5v3.5H9V21h3.5v-8.5H15l.5-3.5h-3V6.8c0-.6.4-.8.9-.8H15z" />
					)}
				</svg>
			</a>
		))
	}
	<span class="copy-status" aria-live="polite" data-copy-status></span>
</div>

<script>
	import '../../scripts/copy';
</script>

<style>
	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2px;
	}

	.icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: var(--tap-target);
		block-size: var(--tap-target);
		padding: 0;
		background: transparent;
		border: 0;
		border-radius: 50%;
		color: var(--color-green-800);
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	.icon-button:hover {
		background: color-mix(in srgb, var(--color-green-800) 8%, transparent);
		color: var(--color-green-950);
	}

	svg {
		inline-size: 22px;
		block-size: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.copy-status {
		margin-inline-start: 8px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-bronze);
	}

	@media (prefers-reduced-motion: reduce) {
		.icon-button {
			transition: none;
		}
	}
</style>
