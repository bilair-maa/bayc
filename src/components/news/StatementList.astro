---
import { formatCalendarDate, type StatementGroups } from '../../data/news';

// Older statements are rendered on the server and collapsed by the script, so
// they stay reachable if JavaScript doesn't run.
interface Props {
	statements: StatementGroups;
}

const { top, older } = Astro.props.statements;
const olderListId = 'older-statements';
---

<div class="statements" data-statements>
	<div class="statements-header">
		<h2 id="statements-heading">Official Statements</h2>
		{
			older.length > 0 && (
				<button
					type="button"
					class="chip toggle"
					aria-expanded="true"
					aria-controls={olderListId}
					hidden
					data-statements-toggle
				>
					Hide Older Statements
				</button>
			)
		}
	</div>

	<ul role="list" class="pinned">
		{
			top.map((statement) => (
				<li>
					<a href={statement.href} class="pinned-statement">
						<span class="statement-meta">
							{statement.pinned && <span class="pinned-label">Pinned</span>}
							<time datetime={statement.date}>{formatCalendarDate(statement.date)}</time>
						</span>
						<span class="statement-title">{statement.title}</span>
						<span class="statement-actions">
							Read <span class="arrow" aria-hidden="true">→</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>

	{
		older.length > 0 && (
			<ul role="list" id={olderListId} class="older" data-statements-older>
				{older.map((statement) => (
					<li>
						<a href={statement.href} class="older-statement">
							<time class="older-date" datetime={statement.date}>
								{formatCalendarDate(statement.date)}
							</time>
							<span class="statement-title">{statement.title}</span>
							<span class="arrow" aria-hidden="true">
								→
							</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</div>

<script>
	const labels = { collapsed: 'See All Statements', expanded: 'Hide Older Statements' };

	for (const root of document.querySelectorAll<HTMLElement>('[data-statements]')) {
		const toggle = root.querySelector<HTMLButtonElement>('[data-statements-toggle]');
		const older = root.querySelector<HTMLElement>('[data-statements-older]');
		if (!toggle || !older) continue;

		const setExpanded = (expanded: boolean) => {
			older.hidden = !expanded;
			toggle.setAttribute('aria-expanded', String(expanded));
			toggle.textContent = expanded ? labels.expanded : labels.collapsed;
		};

		toggle.addEventListener('click', () => {
			setExpanded(toggle.getAttribute('aria-expanded') !== 'true');
		});
		setExpanded(false);
		toggle.hidden = false;
	}
</script>

<style>
	.statements-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px 32px;
		padding-block-end: 18px;
		border-block-end: 2px solid var(--color-green-800);
	}

	h2 {
		font-family: var(--font-serif);
		font-size: clamp(1.875rem, 3vw, 2.5rem);
		font-weight: 500;
		color: var(--color-green-800);
	}

	.toggle {
		padding-inline: 20px;
		font-size: var(--text-base);
		font-weight: 600;
	}

	.pinned {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
		column-gap: 40px;
	}

	.pinned-statement {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-block: 26px 28px;
		border-block-end: 1px solid var(--color-rule);
		color: var(--color-ink);
		text-decoration: none;
	}

	.statement-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.pinned-label {
		font-weight: 700;
		color: var(--color-bronze);
	}

	.statement-title {
		font-family: var(--font-serif);
		font-size: 1.5625rem;
		line-height: 1.25;
		color: var(--color-green-800);
	}

	.pinned-statement:hover .statement-title,
	.older-statement:hover .statement-title {
		text-decoration: underline;
		text-decoration-color: var(--color-gold);
		text-underline-offset: 5px;
	}

	.statement-actions {
		display: flex;
		gap: 10px;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-green-800);
	}

	.arrow {
		color: var(--color-gold);
	}

	.older {
		margin-block-start: 8px;
	}

	.older[hidden] {
		display: none;
	}

	.older-statement {
		display: grid;
		grid-template-columns: 160px 1fr auto;
		align-items: baseline;
		gap: 8px 24px;
		padding-block: 16px;
		border-block-end: 1px solid var(--color-rule);
		text-decoration: none;
	}

	.older-date {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.older-statement .statement-title {
		font-size: 1.3125rem;
	}

	.older-statement .arrow {
		font-size: var(--text-xl);
	}

	@media (max-width: 43.75rem) {
		.older-statement {
			grid-template-columns: 1fr;
		}
	}
</style>
