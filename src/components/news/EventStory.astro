---
import Countdown from './Countdown.astro';
import Eyebrow from './Eyebrow.astro';
import NewsBreadcrumb from './NewsBreadcrumb.astro';
import ReadingProgress from './ReadingProgress.astro';
import RelatedStories from './RelatedStories.astro';
import ShareLinks from './ShareLinks.astro';
import Headshot from '../ui/Headshot.astro';
import RichContent from '../ui/RichContent.astro';
import {
	admissionLabel,
	formatEventDay,
	formatEventTimes,
	isUpcoming,
	mapsHref,
	type EventArticle,
	type Story,
} from '../../data/news';
import { storyCalendarHref } from '../../data/site';

interface Props {
	event: EventArticle;
	related: readonly Story[];
	now: Date;
}

const { event, related, now } = Astro.props;
const upcoming = isUpcoming(event, now);
const startsLater = new Date(event.start).getTime() > now.getTime();
const day = formatEventDay(event.start);
const times = formatEventTimes(event.start, event.end);
const showDirections = event.gettingThere !== undefined || event.venueAddress !== undefined;
---

<ReadingProgress />
<NewsBreadcrumb current="Event" />

<article aria-labelledby="event-heading">
	<section class="container event-header">
		<div class="headline">
			<Eyebrow>Event · {upcoming ? 'Upcoming' : 'Past'}</Eyebrow>
			<h1 id="event-heading">{event.title}</h1>
			{event.summary && <p class="summary">{event.summary}</p>}
		</div>
		<div class="event-bar">
			{startsLater ? <Countdown start={event.start} now={now} /> : <p class="when">{day}</p>}
			<div class="event-actions">
				{
					upcoming && event.rsvpLink && (
						<a href={event.rsvpLink} class="rsvp">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z" />
								<path d="M10 7v10" stroke-dasharray="1.5 2" />
							</svg>
							RSVP
						</a>
					)
				}
				{
					upcoming && (
						<a href={storyCalendarHref(event.id)} class="icon-link" aria-label="Add to calendar" download>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<rect x="3.5" y="5" width="17" height="15.5" rx="1.5" />
								<path d="M3.5 10h17" />
								<path d="M8 3v4" />
								<path d="M16 3v4" />
								<path d="M12 13v4" />
								<path d="M10 15h4" />
							</svg>
						</a>
					)
				}
				<ShareLinks title={event.title} />
			</div>
		</div>
	</section>

	<section class="container event-main">
		<div class="main-column">
			{
				event.image && (
					<figure>
						<img
							class="event-photo"
							src={event.image.src}
							alt={event.photoCaption ?? ''}
							width={event.image.width}
							height={event.image.height}
						/>
						{event.photoCaption && <figcaption>{event.photoCaption}</figcaption>}
					</figure>
				)
			}

			{
				event.body.length > 0 && (
					<div>
						<h2>About This Event</h2>
						<div class="event-body">
							<RichContent blocks={event.body} />
						</div>
					</div>
				)
			}

			{
				event.agenda.length > 0 && (
					<div>
						<h2 class="agenda-heading">Agenda</h2>
						<div class="agenda">
							<RichContent blocks={event.agenda} />
						</div>
					</div>
				)
			}
		</div>

		<aside class="side-column" aria-label="Event details">
			<div>
				<h2 class="side-heading">Details</h2>
				<dl class="details">
					<div class="detail">
						<dt class="visually-hidden">Date</dt>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<rect x="3.5" y="5" width="17" height="15.5" rx="1.5" />
							<path d="M3.5 10h17" />
							<path d="M8 3v4" />
							<path d="M16 3v4" />
						</svg>
						<dd>{day}</dd>
					</div>
					<div class="detail">
						<dt class="visually-hidden">Time</dt>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="8.5" />
							<path d="M12 7.5V12l3 2" />
						</svg>
						<dd>{times}</dd>
					</div>
					{
						(event.venueName || event.venueAddress) && (
							<div class="detail">
								<dt class="visually-hidden">Location</dt>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M12 21s-6.5-6.2-6.5-11A6.5 6.5 0 0 1 18.5 10c0 4.8-6.5 11-6.5 11z" />
									<circle cx="12" cy="10" r="2.3" />
								</svg>
								<dd>
									{event.venueName && <span class="detail-main">{event.venueName}</span>}
									{event.venueAddress && <span class="detail-sub">{event.venueAddress}</span>}
								</dd>
							</div>
						)
					}
					<div class="detail">
						<dt class="visually-hidden">Admission</dt>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z" />
							<path d="M10 7v10" stroke-dasharray="1.5 2" />
						</svg>
						<dd>{admissionLabel(event)}</dd>
					</div>
				</dl>
			</div>

			{
				event.speakers.length > 0 && (
					<div>
						<h2 class="side-heading">Speakers</h2>
						<ul role="list" class="speakers">
							{event.speakers.map((speaker) => (
								<li class="speaker">
									<div class="speaker-photo">
										<Headshot name={speaker.name} photo={speaker.photo} initialsSize={22} />
									</div>
									<div>
										<p class="speaker-name">{speaker.name}</p>
										{speaker.role && <p class="speaker-role">{speaker.role}</p>}
									</div>
								</li>
							))}
						</ul>
					</div>
				)
			}

			{
				showDirections && (
					<div>
						<h2 class="side-heading">Getting There</h2>
						{event.gettingThere && <p class="directions">{event.gettingThere}</p>}
						{event.venueAddress && (
							<a href={mapsHref(event.venueAddress)} class="maps-link">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M12 21s-6.5-6.2-6.5-11A6.5 6.5 0 0 1 18.5 10c0 4.8-6.5 11-6.5 11z" />
									<circle cx="12" cy="10" r="2.3" />
								</svg>
								Open in Maps
							</a>
						)}
					</div>
				)
			}
		</aside>
	</section>
</article>

<RelatedStories stories={related} />

<style>
	.event-header {
		padding-block: 40px 64px;
	}

	.headline {
		display: flex;
		flex-direction: column;
		gap: 18px;
		max-inline-size: 900px;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.75rem, 5.6vw, 5rem);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.02em;
		color: var(--color-green-800);
	}

	.summary {
		font-family: var(--font-serif);
		font-size: clamp(1.375rem, 2vw, 1.625rem);
		font-style: italic;
		line-height: 1.4;
		color: var(--color-text-secondary);
	}

	.event-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px 72px;
		margin-block-start: 44px;
		padding-block: 28px;
		border-block-start: 2px solid var(--color-green-800);
		border-block-end: 1px solid var(--color-rule);
	}

	.when {
		font-family: var(--font-serif);
		font-size: var(--text-3xl);
		color: var(--color-green-800);
	}

	.event-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 16px;
	}

	.rsvp {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		min-block-size: 52px;
		padding-inline: 30px;
		background: var(--color-green-800);
		border-radius: var(--radius);
		color: var(--color-cream);
		font-size: var(--text-md);
		font-weight: 700;
		text-decoration: none;
	}

	.rsvp:hover {
		background: var(--color-green-950);
		color: var(--color-cream);
	}

	.icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: var(--tap-target);
		block-size: var(--tap-target);
		border-radius: 50%;
		color: var(--color-green-800);
	}

	.icon-link:hover {
		background: color-mix(in srgb, var(--color-green-800) 8%, transparent);
	}

	svg {
		inline-size: 22px;
		block-size: 22px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.event-main {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 56px 96px;
		padding-block-end: 104px;
	}

	.main-column {
		flex: 999 1 600px;
		display: flex;
		flex-direction: column;
		gap: 64px;
		min-inline-size: 0;
	}

	.event-photo {
		display: block;
		inline-size: 100%;
		block-size: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius);
	}

	figcaption {
		margin-block-start: 12px;
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	h2 {
		margin-block-end: 18px;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 3.4vw, 2.75rem);
		font-weight: 500;
		color: var(--color-green-800);
	}

	.event-body {
		font-family: var(--font-serif);
		font-size: 1.3125rem;
		line-height: 1.75;
	}

	.agenda-heading {
		margin-block-end: 8px;
	}

	.agenda {
		padding-block-start: 20px;
		border-block-start: 2px solid var(--color-green-800);
		font-size: var(--text-lg);
		line-height: 1.65;
	}

	/* Each paragraph of the agenda reads as one line item. */
	.agenda :global(.rich-content > p) {
		padding-block-end: 16px;
		border-block-end: 1px solid var(--color-rule);
	}

	.agenda :global(.bold) {
		color: var(--color-bronze);
	}

	.side-column {
		flex: 1 1 320px;
		display: flex;
		flex-direction: column;
		gap: 48px;
		min-inline-size: 0;
	}

	.side-heading {
		margin-block-end: 6px;
		font-size: 1.875rem;
	}

	.detail {
		display: grid;
		grid-template-columns: 44px 1fr;
		gap: 2px 10px;
		align-items: start;
		padding-block: 16px;
		border-block-end: 1px solid var(--color-rule);
	}

	.detail svg {
		inline-size: 24px;
		block-size: 24px;
		margin-block-start: 2px;
		color: var(--color-bronze);
	}

	dd,
	.detail-main {
		display: flex;
		flex-direction: column;
		gap: 2px;
		font-family: var(--font-serif);
		font-size: 1.3125rem;
		color: var(--color-green-800);
	}

	.detail-sub {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.speakers {
		display: flex;
		flex-direction: column;
		gap: 18px;
		margin-block-start: 12px;
	}

	.speaker {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.speaker-photo {
		flex: none;
		inline-size: 64px;
		block-size: 80px;
	}

	.speaker-name {
		font-family: var(--font-serif);
		font-size: 1.3125rem;
		color: var(--color-green-800);
	}

	.speaker-role {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.directions {
		margin-block-start: 8px;
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.maps-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-block-size: var(--tap-target);
		margin-block-start: 10px;
		font-weight: 700;
		text-decoration-color: var(--color-gold);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.maps-link svg {
		inline-size: 18px;
		block-size: 18px;
	}

</style>
