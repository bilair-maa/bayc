---
import { formatDate, type Story } from '../../data/news';

// A grid of news or event cards, shown a page at a time with "Load More".
interface Props {
	stories: readonly Story[];
	// Small label above each title, e.g. "News" or "Event".
	label: string;
}

const { stories, label } = Astro.props;
const pageSize = 6;
---

<div class="story-grid-block" data-load-more data-page-size={pageSize}>
	<ul role="list" class="story-grid">
		{
			stories.map((story) => (
				<li data-load-more-item>
					<a href={story.href} class="story">
						<div class="story-media">
							{story.image ? (
								<img
									src={story.image.src}
									alt=""
									width={story.image.width}
									height={story.image.height}
									loading="lazy"
								/>
							) : (
								<div class="story-media-brand">
									<img src="/images/bayc-seal.png" alt="" width="120" height="120" loading="lazy" />
								</div>
							)}
						</div>
						<div class="story-body">
							<span class="story-meta">
								<span class="story-type">{label}</span>
								<time datetime={story.date}>{formatDate(story.date)}</time>
							</span>
							<span class="story-title">{story.title}</span>
							{story.summary && <span class="story-excerpt">{story.summary}</span>}
						</div>
					</a>
				</li>
			))
		}
	</ul>
	{
		stories.length > pageSize && (
			<div class="load-more-row">
				<button type="button" class="chip load-more" hidden data-load-more-button>
					Load More
				</button>
			</div>
		)
	}
</div>

<script>
	// Every card is rendered on the server; the script shows them a page at a
	// time, so the full grid still shows if it doesn't run.
	for (const root of document.querySelectorAll<HTMLElement>('[data-load-more]')) {
		const button = root.querySelector<HTMLButtonElement>('[data-load-more-button]');
		const items = [...root.querySelectorAll<HTMLElement>('[data-load-more-item]')];
		const pageSize = Number(root.dataset.pageSize);
		if (!button || !pageSize) continue;

		let shown = pageSize;
		const update = () => {
			items.forEach((item, index) => (item.hidden = index >= shown));
			button.hidden = shown >= items.length;
		};
		button.addEventListener('click', () => {
			const firstNew = items[shown];
			shown += pageSize;
			update();
			// Keyboard users continue from the first newly shown card.
			firstNew?.querySelector<HTMLElement>('a')?.focus();
		});
		update();
	}
</script>

<style>
	.story-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
		gap: 28px;
	}

	.story-grid > li[hidden] {
		display: none;
	}

	.load-more-row {
		display: flex;
		justify-content: flex-end;
		margin-block-start: 48px;
	}

	.load-more {
		padding-inline: 24px;
		font-size: var(--text-base);
		font-weight: 600;
	}

	.load-more[hidden] {
		display: none;
	}

	.story {
		display: flex;
		flex-direction: column;
		block-size: 100%;
		overflow: hidden;
		background: var(--color-surface);
		border-radius: var(--radius);
		color: var(--color-ink);
		text-decoration: none;
	}

	.story-media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.story-media img {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.story:hover .story-media img {
		transform: scale(1.06);
	}

	/* Stands in for a photo when none was added, keeping cards uniform. */
	.story-media-brand {
		display: flex;
		align-items: center;
		justify-content: center;
		block-size: 100%;
		background: var(--color-green-800);
	}

	.story-media .story-media-brand img {
		inline-size: 120px;
		block-size: 120px;
		object-fit: contain;
		opacity: 0.9;
	}

	.story-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px 26px 28px;
	}

	.story-meta {
		display: flex;
		gap: 14px;
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.story-type {
		color: var(--color-bronze);
	}

	.story-title {
		font-family: var(--font-serif);
		font-size: var(--text-3xl);
		line-height: 1.22;
		color: var(--color-green-800);
	}

	.story:hover .story-title {
		text-decoration: underline;
		text-decoration-color: var(--color-gold);
		text-underline-offset: 5px;
	}

	.story-excerpt {
		font-size: var(--text-base);
		line-height: 1.55;
		color: var(--color-text-secondary);
	}

	@media (prefers-reduced-motion: reduce) {
		.story-media img {
			transition: none;
		}
	}
</style>
