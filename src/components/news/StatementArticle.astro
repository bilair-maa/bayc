---
import Eyebrow from './Eyebrow.astro';
import NewsBreadcrumb from './NewsBreadcrumb.astro';
import ReadingProgress from './ReadingProgress.astro';
import ShareLinks from './ShareLinks.astro';
import RichContent from '../ui/RichContent.astro';
import { formatCalendarDate, type Statement, type StatementArticle } from '../../data/news';
import { routes, site } from '../../data/site';

// An official statement's page content.
interface Props {
	statement: StatementArticle;
	others: readonly Statement[];
}

const { statement, others } = Astro.props;
---

<ReadingProgress />
<NewsBreadcrumb current="Official Statement" />
<article class="container statement" aria-labelledby="statement-heading">
	<div class="main-column">
		<header class="statement-header">
			<Eyebrow>Official Statement</Eyebrow>
			<h1 id="statement-heading">{statement.title}</h1>
			<div class="byline-row">
				<p class="byline">
					<time datetime={statement.date}>{formatCalendarDate(statement.date)}</time> · {site.name}
				</p>
				<ShareLinks title={statement.title} />
			</div>
		</header>

		{statement.keyPoints.length > 0 && (
			<details class="glance" open>
				<summary>
					<span class="glance-label">At a Glance</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" class="chevron">
						<path d="M6 9l6 6 6-6" />
					</svg>
				</summary>
				<ol role="list" class="key-points">
					{statement.keyPoints.map((point, index) => (
						<li class="key-point">
							<span class="point-number" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<span>{point}</span>
						</li>
					))}
				</ol>
			</details>
		)}

		{statement.body.length > 0 && (
			<div class="statement-body">
				<RichContent blocks={statement.body} copyableQuotes />
			</div>
		)}

		<footer class="signature">
			<div class="signature-text">
				<span class="signed-by">{statement.signedBy ?? 'The Leadership Council'}</span>
				<span class="organization">{site.name}</span>
				{statement.pdfUrl && (
					<a href={statement.pdfUrl} class="pdf-link">
						Download PDF
					</a>
				)}
			</div>
			<ShareLinks title={statement.title} />
		</footer>
	</div>

	<aside class="side-column" aria-label="More from BAYC">
		<div class="media-inquiries">
			<p class="side-title">Media Inquiries</p>
			<p>For interviews or comment on this statement:</p>
			<a href={`mailto:${site.email}`} class="text-link-strong">
				{site.email}
			</a>
		</div>
		{others.length > 0 && (
			<div>
				<h2 class="others-heading">Other Statements</h2>
				<ul role="list">
					{others.map((other) => (
						<li>
							<a href={other.href} class="other">
								<time datetime={other.date} class="other-date">
									{formatCalendarDate(other.date)}
								</time>
								<span class="other-title">{other.title}</span>
							</a>
						</li>
					))}
				</ul>
				<a href={`${routes.news}#statements`} class="text-link-strong all-link">
					All Statements
				</a>
			</div>
		)}
	</aside>
</article>

<style>
	.statement {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 56px 104px;
		padding-block: 48px var(--space-section);
	}

	.main-column {
		flex: 999 1 620px;
		min-inline-size: 0;
		max-inline-size: 760px;
	}

	.statement-header {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding-block-end: 28px;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.5rem, 4.6vw, 4rem);
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: -0.015em;
		color: var(--color-green-800);
	}

	.byline-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
	}

	.byline {
		font-size: var(--text-base);
		color: var(--color-text-muted);
	}

	.glance summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-block-size: var(--tap-target);
		padding-block: 18px;
		border-block-start: 2px solid var(--color-green-800);
		border-block-end: 1px solid var(--color-rule);
		color: var(--color-green-800);
		list-style: none;
		cursor: pointer;
	}

	.glance summary::-webkit-details-marker {
		display: none;
	}

	.glance-label {
		font-family: var(--font-serif);
		font-size: var(--text-2xl);
		transition: color 0.2s ease;
	}

	.glance summary:hover .glance-label {
		color: var(--color-bronze);
	}

	.chevron {
		inline-size: 22px;
		block-size: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.3s ease;
	}

	.glance[open] .chevron {
		transform: rotate(180deg);
	}

	.key-point {
		display: grid;
		grid-template-columns: 40px 1fr;
		gap: 4px 12px;
		padding-block: 16px;
		border-block-end: 1px solid var(--color-rule);
		font-size: var(--text-lg);
		line-height: 1.55;
	}

	.point-number {
		font-family: var(--font-serif);
		font-style: italic;
		color: var(--color-bronze);
	}

	.statement-body {
		padding-block: 40px 28px;
		font-family: var(--font-serif);
		font-size: 1.375rem;
		line-height: 1.75;
	}

	/* The opening paragraph is set larger, as a lede. */
	.statement-body :global(.rich-content > p:first-child) {
		font-size: 1.23em;
		line-height: 1.5;
		color: var(--color-green-800);
	}

	.signature {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		padding-block-start: 28px;
		border-block-start: 1px solid var(--color-rule);
	}

	.signature-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.signed-by {
		font-family: var(--font-serif);
		font-size: 1.875rem;
		font-style: italic;
		color: var(--color-green-800);
	}

	.organization {
		color: var(--color-text-muted);
	}

	.pdf-link {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--tap-target);
		font-weight: 700;
		text-decoration-color: var(--color-gold);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.side-column {
		flex: 1 1 300px;
		display: flex;
		flex-direction: column;
		gap: 48px;
		min-inline-size: 0;
		padding-block-start: 8px;
	}

	.media-inquiries {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-inline-start: 24px;
		border-inline-start: 3px solid var(--color-gold);
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.side-title {
		font-family: var(--font-serif);
		font-size: var(--text-3xl);
		color: var(--color-green-800);
	}

	.text-link-strong {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--tap-target);
		font-size: var(--text-md);
		font-weight: 700;
		text-decoration-color: var(--color-gold);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.others-heading {
		padding-block-end: 12px;
		border-block-end: 2px solid var(--color-green-800);
		font-family: var(--font-serif);
		font-size: var(--text-3xl);
		font-weight: 500;
		color: var(--color-green-800);
	}

	.other {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-block: 18px;
		border-block-end: 1px solid var(--color-rule);
		color: var(--color-ink);
		text-decoration: none;
	}

	.other-date {
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.other-title {
		font-family: var(--font-serif);
		font-size: 1.3125rem;
		line-height: 1.3;
		color: var(--color-green-800);
	}

	.other:hover .other-title {
		text-decoration: underline;
		text-decoration-color: var(--color-gold);
		text-underline-offset: 5px;
	}

	.all-link {
		margin-block-start: 16px;
	}


	@media (prefers-reduced-motion: reduce) {
		.chevron,
		.glance-label {
			transition: none;
		}
	}
</style>
