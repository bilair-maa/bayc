---
import Button from '../ui/Button.astro';
import FormProtection from '../ui/FormProtection.astro';

import { roles, interests, formFields } from '../../data/formFields';
---

<form
	data-form="membership"
	method="post"
	action="/api/forms/membership"
	class="application-form"
	aria-labelledby="application-heading"
	aria-describedby="application-status"
>
	<h3 id="application-heading">Membership Application</h3>

	<div class="field-row">
		<label class="field">
			First Name
			<input
				class="input"
				type="text"
				name="first_name"
				autocomplete="given-name"
				required
				aria-describedby="membership-first_name-error"
				maxlength={formFields.membership.first_name.maxLength}
			/>
			<span
				class="field-error"
				id="membership-first_name-error"
				data-error="first_name"
				role="alert"
			></span>
		</label>
		<label class="field">
			Last Name
			<input
				class="input"
				type="text"
				name="last_name"
				autocomplete="family-name"
				required
				aria-describedby="membership-last_name-error"
				maxlength={formFields.membership.last_name.maxLength}
			/>
			<span
				class="field-error"
				id="membership-last_name-error"
				data-error="last_name"
				role="alert"
			></span>
		</label>
	</div>

	<div class="field-row">
		<label class="field">
			Email
			<input
				class="input"
				type="email"
				name="email"
				autocomplete="email"
				placeholder="you@example.com"
				required
				aria-describedby="membership-email-error"
				maxlength={formFields.membership.email.maxLength}
			/>
			<span
				class="field-error"
				id="membership-email-error"
				data-error="email"
				role="alert"
			></span>
		</label>
		<label class="field">
			City & State
			<input
				class="input"
				type="text"
				name="city"
				autocomplete="address-level2"
				placeholder="e.g. Queens, NY"
				aria-describedby="membership-city-error"
				maxlength={formFields.membership.city.maxLength}
			/>
			<span
				class="field-error"
				id="membership-city-error"
				data-error="city"
				role="alert"
			></span>
		</label>
	</div>

	<fieldset aria-describedby="membership-role-error">
		<legend>I am a</legend>
		<div class="choices">
			{roles.map((role) => (
				<label class="choice">
					<input type="radio" name="role" value={role.value} required />
					{role.label}
				</label>
			))}
		</div>
		<span
			class="field-error"
			id="membership-role-error"
			data-error="role"
			role="alert"
		></span>
	</fieldset>

	<fieldset aria-describedby="membership-interests-error">
		<legend>Interested In</legend>
		<div class="choices choices-grid">
			{interests.map((interest) => (
				<label class="choice">
					<input type="checkbox" name="interests" value={interest.value} />
					{interest.label}
				</label>
			))}
		</div>
		<span
			class="field-error"
			id="membership-interests-error"
			data-error="interests"
			role="alert"
		></span>
	</fieldset>

	<label class="field">
		Why do you want to join? (optional)
		<textarea
			class="input message"
			name="message"
			rows="4"
			aria-describedby="membership-message-error"
			maxlength={formFields.membership.message.maxLength}
		></textarea>
		<span
			class="field-error"
			id="membership-message-error"
			data-error="message"
			role="alert"
		></span>
	</label>

	<div class="submit-row">
		<Button type="submit" variant="green" disabled>
			Submit Application
		</Button>
		<p
			id="application-status"
			class="status"
			data-form-status
			role="status"
			aria-live="polite"
		></p>
	</div>
	<FormProtection />
</form>

<style>
	.application-form {
		display: flex;
		flex-direction: column;
		gap: 22px;
		padding: clamp(24px, 4vw, 48px);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-block-start: 4px solid var(--color-gold);
		border-radius: var(--radius);
	}

	h3 {
		font-family: var(--font-serif);
		font-size: 1.875rem;
		font-weight: 600;
		color: var(--color-green-800);
	}

	.field-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
		gap: 18px;
	}

	fieldset {
		margin: 0;
		padding: 0;
		border: 0;
	}

	legend {
		margin-block-end: 10px;
		padding: 0;
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.choices {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		font-size: var(--text-md);
	}

	.choices-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
		gap: 4px 24px;
	}

	.choice {
		display: flex;
		align-items: center;
		gap: 10px;
		min-block-size: var(--tap-target);
	}

	.choice input {
		inline-size: 20px;
		block-size: 20px;
		margin: 0;
		accent-color: var(--color-green-800);
	}

	.message {
		resize: vertical;
	}

	.submit-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 20px;
	}

	.status {
		font-size: var(--text-sm);
		color: var(--color-text-secondary);
	}
</style>
