---
import Button from '../ui/Button.astro';
import FormProtection from '../ui/FormProtection.astro';

import { topics, formFields } from '../../data/formFields';
---

<form
	data-form="contact"
	method="post"
	action="/api/forms/contact"
	class="contact-form"
	aria-labelledby="contact-form-heading"
	aria-describedby="contact-status"
>
	<h2 id="contact-form-heading">Send a Message</h2>

	<fieldset aria-describedby="contact-topic-error">
		<legend>What is this about?</legend>
		<div class="topics">
			{topics.map((topic, index) => (
				<label class="topic">
					<input
						class="visually-hidden"
						type="radio"
						name="topic"
						value={topic.value}
						checked={index === 0}
						required
					/>
					<span class="topic-label">{topic.label}</span>
					<span class="topic-description">{topic.description}</span>
				</label>
			))}
		</div>
		<span
			class="field-error"
			id="contact-topic-error"
			data-error="topic"
			role="alert"
		></span>
	</fieldset>

	<div class="field-row">
		<label class="field">
			Name
			<input
				class="input"
				type="text"
				name="name"
				autocomplete="name"
				required
				aria-describedby="contact-name-error"
				maxlength={formFields.contact.name.maxLength}
			/>
			<span
				class="field-error"
				id="contact-name-error"
				data-error="name"
				role="alert"
			></span>
		</label>
		<label class="field">
			Email
			<input
				class="input"
				type="email"
				name="email"
				autocomplete="email"
				placeholder="you@example.com"
				required
				aria-describedby="contact-email-error"
				maxlength={formFields.contact.email.maxLength}
			/>
			<span
				class="field-error"
				id="contact-email-error"
				data-error="email"
				role="alert"
			></span>
		</label>
	</div>

	<label class="field">
		Message
		<textarea
			class="input message"
			name="message"
			rows="5"
			required
			aria-describedby="contact-message-error"
			maxlength={formFields.contact.message.maxLength}
		></textarea>
		<span
			class="field-error"
			id="contact-message-error"
			data-error="message"
			role="alert"
		></span>
	</label>

	<div class="submit-row">
		<Button type="submit" variant="green" disabled>
			Send Message
		</Button>
		<p
			id="contact-status"
			class="status"
			data-form-status
			role="status"
			aria-live="polite"
		></p>
	</div>
	<FormProtection />
</form>

<style>
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: clamp(28px, 4vw, 48px);
		background: var(--color-surface);
		border-block-start: 4px solid var(--color-gold);
		border-radius: var(--radius);
		box-shadow: var(--shadow-raised);
	}

	h2 {
		font-family: var(--font-serif);
		font-size: clamp(2rem, 3vw, 2.625rem);
		font-weight: 500;
		color: var(--color-green-800);
	}

	fieldset {
		margin: 0;
		padding: 0;
		border: 0;
	}

	legend {
		margin-block-end: 12px;
		padding: 0;
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.topics {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
		gap: 10px;
	}

	.topic {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-block-size: var(--tap-target);
		padding: 16px 18px;
		background: var(--color-field);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.topic:hover {
		border-color: var(--color-green-800);
	}

	.topic:has(input:checked) {
		background: var(--color-green-800);
		border-color: var(--color-green-800);
		color: var(--color-cream);
	}

	/* The radio itself is hidden, so its card shows the keyboard focus. */
	.topic:has(input:focus-visible) {
		outline: 3px solid var(--color-gold);
		outline-offset: 3px;
	}

	.topic-label {
		font-family: var(--font-serif);
		font-size: 1.3125rem;
		line-height: 1.2;
	}

	.topic-description {
		font-size: 0.875rem;
		color: var(--color-bronze);
	}

	.topic:has(input:checked) .topic-description {
		color: var(--color-gold-light);
	}

	.field-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
		gap: 18px;
	}

	.message {
		resize: vertical;
	}

	.submit-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 20px;
	}

	.status {
		font-size: var(--text-sm);
		color: var(--color-text-secondary);
	}

	@media (prefers-reduced-motion: reduce) {
		.topic {
			transition: none;
		}
	}
</style>
