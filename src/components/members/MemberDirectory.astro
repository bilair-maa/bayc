---
import Headshot from '../ui/Headshot.astro';
import { fieldsOf, type DirectoryMember } from '../../data/members';

// Filtering happens in the browser. Every member is rendered on the server,
// so the full list still shows if the script doesn't run; the filter controls
// stay hidden until it does.
interface Props {
	members: readonly DirectoryMember[];
}

const { members } = Astro.props;
const memberFields = fieldsOf(members);
const allFields = 'All Fields';
---

<div class="directory" data-directory>
	<div class="filters" hidden data-directory-filters>
		<label class="field search">
			Search by name or profession
			<input
				class="input"
				type="search"
				placeholder="e.g. engineer, attorney, teacher"
				data-directory-query
			/>
		</label>
		{
			memberFields.length > 1 && (
				<div role="group" aria-label="Filter by field" class="field-buttons">
					{[allFields, ...memberFields].map((field) => (
						<button
							type="button"
							class="chip"
							aria-pressed={field === allFields ? 'true' : 'false'}
							data-directory-field={field === allFields ? '' : field}
						>
							{field}
						</button>
					))}
				</div>
			)
		}
	</div>

	<p class="count" aria-live="polite" data-directory-count></p>

	<ul role="list" class="member-grid">
		{
			members.map((member) => (
				<li
					data-member
					data-field={member.field ?? ''}
					data-search={[member.name, member.profession, member.field]
						.filter((part) => part !== undefined)
						.join(' ')
						.toLowerCase()}
				>
					<article class="member">
						<div class="photo">
							<Headshot name={member.name} photo={member.photo} initialsSize={28} />
						</div>
						<div class="details">
							<h3>{member.name}</h3>
							{member.profession && <p class="profession">{member.profession}</p>}
							{(member.field || member.city) && (
								<p class="meta">
									{[member.field, member.city].filter((part) => part !== undefined).join(' · ')}
								</p>
							)}
						</div>
					</article>
				</li>
			))
		}
	</ul>

	<div class="empty" hidden data-directory-empty>
		<p>No members match those filters.</p>
		<button type="button" class="chip" data-directory-reset>Clear Filters</button>
	</div>
</div>

<script>
	const plural = new Intl.PluralRules('en');
	const countLabel = (count: number) =>
		`Showing ${count} ${plural.select(count) === 'one' ? 'member' : 'members'}`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-directory]')) {
		const filters = root.querySelector<HTMLElement>('[data-directory-filters]');
		const query = root.querySelector<HTMLInputElement>('[data-directory-query]');
		const count = root.querySelector<HTMLElement>('[data-directory-count]');
		const empty = root.querySelector<HTMLElement>('[data-directory-empty]');
		const reset = root.querySelector<HTMLButtonElement>('[data-directory-reset]');
		const fieldButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-directory-field]')];
		const items = [...root.querySelectorAll<HTMLElement>('[data-member]')];
		if (!filters || !query || !count || !empty || !reset) continue;

		let selectedField = '';

		const update = () => {
			const text = query.value.trim().toLowerCase();
			let visible = 0;
			for (const item of items) {
				const matches =
					(!selectedField || item.dataset.field === selectedField) &&
					(!text || (item.dataset.search ?? '').includes(text));
				item.hidden = !matches;
				if (matches) visible += 1;
			}
			for (const button of fieldButtons) {
				button.setAttribute('aria-pressed', String(button.dataset.directoryField === selectedField));
			}
			count.textContent = countLabel(visible);
			empty.hidden = visible > 0;
		};

		for (const button of fieldButtons) {
			button.addEventListener('click', () => {
				selectedField = button.dataset.directoryField ?? '';
				update();
			});
		}
		query.addEventListener('input', update);
		reset.addEventListener('click', () => {
			selectedField = '';
			query.value = '';
			update();
		});

		filters.hidden = false;
		update();
	}
</script>

<style>
	.filters {
		display: flex;
		flex-direction: column;
		gap: 22px;
		padding-block-end: 32px;
		border-block-end: 1px solid var(--color-rule);
	}

	.filters[hidden] {
		display: none;
	}

	.search {
		gap: 8px;
		max-inline-size: 640px;
	}

	.search .input {
		background: var(--color-surface);
	}

	.field-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.count {
		margin-block: 24px 8px;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.member-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
		column-gap: 40px;
	}

	.member {
		display: flex;
		align-items: flex-start;
		gap: 18px;
		padding-block: 28px;
		border-block-end: 1px solid var(--color-rule);
	}

	.photo {
		flex: none;
		inline-size: 88px;
		block-size: 110px;
	}

	.details {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-inline-size: 0;
	}

	h3 {
		font-family: var(--font-serif);
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-green-800);
	}

	.profession {
		font-size: var(--text-base);
		line-height: 1.4;
	}

	.meta {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.empty {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
		padding-block: 56px;
	}

	.empty[hidden] {
		display: none;
	}

	.empty p {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		color: var(--color-green-800);
	}
</style>
