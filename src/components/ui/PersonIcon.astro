---
// Decorative person silhouette; takes its stroke color from `color`.
interface Props {
	size: number;
	strokeWidth?: number;
}

const { size, strokeWidth = 1.2 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	aria-hidden="true"
>
	<circle cx="12" cy="8" r="4"></circle>
	<path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path>
</svg>
