---
import { socialProfiles } from '../../data/site';

// BAYC's social profiles as icons, colored by the parent's `color`. A profile
// without a link yet shows as a labelled icon rather than a dead link.
---

<ul role="list" class="socials">
	{
		socialProfiles.map((profile) => {
			const icon = (
				<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
					{profile.network === 'instagram' && (
						<g fill="none" stroke="currentColor" stroke-width="2">
							<rect x="3" y="3" width="18" height="18" rx="5" />
							<circle cx="12" cy="12" r="4" />
							<circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
						</g>
					)}
					{profile.network === 'facebook' && (
						<path
							fill="currentColor"
							d="M13.5 21v-7.5H16l.5-3h-3V8.6c0-.9.3-1.6 1.6-1.6h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H8v3h2.5V21z"
						/>
					)}
					{profile.network === 'linkedin' && (
						<path
							fill="currentColor"
							d="M4 9h3.6v11H4zm1.8-5.6a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2M9.8 9h3.4v1.5h.1c.5-.9 1.7-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.4V20h-3.6v-5.3c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V20H9.8z"
						/>
					)}
				</svg>
			);
			return (
				<li>
					{profile.href ? (
						<a href={profile.href} class="social" aria-label={`BAYC on ${profile.label}`}>
							{icon}
						</a>
					) : (
						<span class="social" role="img" aria-label={profile.label}>
							{icon}
						</span>
					)}
				</li>
			);
		})
	}
</ul>

<style>
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		margin-inline-start: -11px;
	}

	.social {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: var(--tap-target);
		block-size: var(--tap-target);
		color: inherit;
	}

	a.social {
		border-radius: var(--radius);
		transition: color 0.2s ease;
	}

	a.social:hover {
		color: var(--color-gold);
	}

	@media (prefers-reduced-motion: reduce) {
		a.social {
			transition: none;
		}
	}
</style>
