---
import HeadshotPlaceholder from '../ui/HeadshotPlaceholder.astro';
import ReadMore from '../ui/ReadMore.astro';
import type { CouncilMember } from '../../data/leadership';

interface Props {
	officer: CouncilMember;
}

const { officer } = Astro.props;
---

<article class="officer">
	<div class="photo">
		<HeadshotPlaceholder iconSize={72} />
	</div>
	<p class="title">{officer.title}</p>
	<h3>
		{officer.name}
		<span class="divider" aria-hidden="true">|</span>
		<span class="city">{officer.city}</span>
	</h3>
	<p>{officer.shortBio}</p>
	<ReadMore id={officer.id}>
		<p>{officer.fullBio}</p>
	</ReadMore>
</article>

<style>
	.officer {
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: var(--text-md);
		line-height: 1.65;
	}

	.photo {
		aspect-ratio: 4 / 5;
	}

	.title {
		margin-block-start: 6px;
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.4;
		color: var(--color-bronze);
	}

	h3 {
		font-family: var(--font-serif);
		font-size: var(--text-3xl);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-green-800);
	}

	.divider {
		font-weight: 400;
		color: var(--color-gold);
	}

	.city {
		font-size: var(--text-lg);
		font-weight: 400;
		color: var(--color-text-secondary);
	}
</style>
