---
import '../styles/global.css';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { site } from '../data/site';

interface Props {
	// Omitted on the home page, which uses the organization name alone.
	pageTitle?: string;
}

const { pageTitle } = Astro.props;
const title = pageTitle ? `${pageTitle} — ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/images/bayc-seal.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Public+Sans:wght@400;500;600;700&family=Noto+Serif+Bengali:wght@500&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
