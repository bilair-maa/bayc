---
import FeaturedCarousel from '../components/news/FeaturedCarousel.astro';
import StatementList from '../components/news/StatementList.astro';
import Layout from '../layouts/Layout.astro';
import { featuredStories, stories } from '../data/news';
import { site } from '../data/site';

const sections = [
	{ id: 'statements', label: 'Official Statements' },
	{ id: 'news', label: 'News & Events' },
] as const;
const [statementsSection, newsSection] = sections;
---

<Layout pageTitle="News & Statements">
	<section class="container intro" aria-labelledby="news-page-heading">
		<h1 id="news-page-heading" class="page-title">News &amp;<br />Statements</h1>
		<nav aria-label="On this page" class="jump-nav">
			{
				sections.map((section) => (
					<a href={`#${section.id}`} class="jump-link">
						{section.label} <span aria-hidden="true">↓</span>
					</a>
				))
			}
		</nav>
	</section>

	<section
		id={statementsSection.id}
		class="container statements"
		aria-labelledby="statements-heading"
	>
		<StatementList />
	</section>

	<section id={newsSection.id} class="news" aria-labelledby="news-heading">
		<div class="container news-header">
			<h2 id="news-heading">{newsSection.label}</h2>
			<p>Media inquiries: <a href={`mailto:${site.email}`}>{site.email}</a></p>
		</div>
		<div class="container">
			<FeaturedCarousel stories={featuredStories} />
		</div>
		<div class="container stories">
			<ul role="list" class="story-grid">
				{
					stories.map((story) => (
						<li>
							<a href={story.href} class="story">
								<div class="story-media">
									<img
										src={story.image.src}
										alt=""
										width={story.image.width}
										height={story.image.height}
										loading="lazy"
										style={`object-position: ${story.image.focus}`}
									/>
								</div>
								<div class="story-body">
									<span class="story-meta">
										<span class="story-type">{story.type}</span>
										<span>{story.date}</span>
									</span>
									<span class="story-title">{story.title}</span>
									<span class="story-excerpt">{story.excerpt}</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>
			<p class="image-note">
				[Images are placeholders from the site's photo library. Replace with photos from each story.]
			</p>
		</div>
	</section>
</Layout>

<style>
	.intro {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px 80px;
		padding-block: 96px 56px;
	}

	.jump-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 40px;
	}

	.jump-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding-block: 10px;
		border-block-end: 2px solid var(--color-gold);
		color: var(--color-green-800);
		font-family: var(--font-serif);
		font-size: var(--text-2xl);
		text-decoration: none;
	}

	.jump-link:hover {
		color: var(--color-green-950);
	}

	.jump-link span {
		color: var(--color-gold);
	}

	.statements {
		padding-block-end: 24px;
	}

	.news {
		padding-block-start: 88px;
	}

	.news-header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px 48px;
		padding-block-end: 40px;
	}

	.news-header h2 {
		font-family: var(--font-serif);
		font-size: clamp(2.5rem, 4.4vw, 3.75rem);
		font-weight: 500;
		line-height: 1.05;
		color: var(--color-green-800);
	}

	.news-header p {
		font-size: var(--text-md);
		color: var(--color-text-secondary);
	}

	.news-header a {
		font-weight: 600;
	}

	.stories {
		padding-block: 48px var(--space-section);
	}

	.story-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
		gap: 28px;
	}

	.story {
		display: flex;
		flex-direction: column;
		block-size: 100%;
		overflow: hidden;
		background: var(--color-surface);
		border-radius: var(--radius);
		color: var(--color-ink);
		text-decoration: none;
	}

	.story-media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.story-media img {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.story:hover .story-media img {
		transform: scale(1.06);
	}

	.story-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px 26px 28px;
	}

	.story-meta {
		display: flex;
		gap: 14px;
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.story-type {
		color: var(--color-bronze);
	}

	.story-title {
		font-family: var(--font-serif);
		font-size: var(--text-3xl);
		line-height: 1.22;
		color: var(--color-green-800);
	}

	.story:hover .story-title {
		text-decoration: underline;
		text-decoration-color: var(--color-gold);
		text-underline-offset: 5px;
	}

	.story-excerpt {
		font-size: var(--text-base);
		line-height: 1.55;
		color: var(--color-text-secondary);
	}

	.image-note {
		margin-block-start: 48px;
		font-size: 0.875rem;
		color: var(--color-bronze);
	}

	@media (prefers-reduced-motion: reduce) {
		.story-media img {
			transition: none;
		}
	}
</style>
