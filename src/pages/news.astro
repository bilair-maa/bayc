---
import EventCarousel from '../components/news/EventCarousel.astro';
import StatementList from '../components/news/StatementList.astro';
import StoryGrid from '../components/news/StoryGrid.astro';
import Layout from '../layouts/Layout.astro';
import { getEvents, getNews, getStatements } from '../data/news';
import { site } from '../data/site';

const now = new Date();
const [statements, events, news] = await Promise.all([getStatements(), getEvents(now), getNews()]);

const statementsSection = { id: 'statements', label: 'Official Statements' };
const eventsSection = { id: 'events', label: 'Events' };
const newsSection = { id: 'news', label: 'News' };
const showStatements = statements.top.length > 0;
const showEvents = events.upcoming.length > 0 || events.past.length > 0;
const showNews = news.length > 0;
const sections = [
	...(showStatements ? [statementsSection] : []),
	...(showEvents ? [eventsSection] : []),
	...(showNews ? [newsSection] : []),
];
---

<Layout pageTitle="News & Events">
	<section class="container intro" aria-labelledby="news-page-heading">
		<h1 id="news-page-heading" class="page-title">News &amp; Events</h1>
		{
			sections.length > 1 && (
				<nav aria-label="On this page" class="jump-nav">
					{sections.map((section) => (
						<a href={`#${section.id}`} class="jump-link">
							{section.label} <span aria-hidden="true">↓</span>
						</a>
					))}
				</nav>
			)
		}
	</section>

	{
		sections.length === 0 && (
			<div class="container empty">
				<p class="coming-soon">News, events and official statements from BAYC will be posted here.</p>
			</div>
		)
	}

	{
		showStatements && (
			<section id={statementsSection.id} class="container statements" aria-labelledby="statements-heading">
				<StatementList statements={statements} />
			</section>
		)
	}

	{
		showEvents && (
			<section id={eventsSection.id} class="container page-section" aria-labelledby="events-heading">
				<div class="section-header">
					<h2 id="events-heading">{eventsSection.label}</h2>
				</div>
				{events.upcoming.length > 0 ? (
					<EventCarousel stories={events.upcoming} />
				) : (
					<p class="no-upcoming">No upcoming events right now. Check back soon.</p>
				)}
				{events.past.length > 0 && (
					<div class="past-events">
						<h3>Past Events</h3>
						<StoryGrid stories={events.past} label="Event" />
					</div>
				)}
			</section>
		)
	}

	{
		showNews && (
			<section id={newsSection.id} class="container page-section" aria-labelledby="news-heading">
				<div class="section-header">
					<h2 id="news-heading">{newsSection.label}</h2>
					<p>
						Media inquiries: <a href={`mailto:${site.email}`}>{site.email}</a>
					</p>
				</div>
				<StoryGrid stories={news} label="News" />
			</section>
		)
	}
</Layout>

<style>
	.intro {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px 80px;
		padding-block: 96px 56px;
	}

	.jump-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 40px;
	}

	.jump-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding-block: 10px;
		border-block-end: 2px solid var(--color-gold);
		color: var(--color-green-800);
		font-family: var(--font-serif);
		font-size: var(--text-2xl);
		text-decoration: none;
	}

	.jump-link:hover {
		color: var(--color-green-950);
	}

	.jump-link span {
		color: var(--color-gold);
	}

	.empty {
		padding-block: 40px var(--space-section);
		border-block-start: 1px solid var(--color-rule);
	}

	.coming-soon {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		color: var(--color-green-800);
	}

	.statements {
		padding-block-end: 24px;
	}

	.page-section {
		padding-block-start: 88px;
	}

	.page-section:last-of-type {
		padding-block-end: var(--space-section);
	}

	.section-header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px 48px;
		margin-block-end: 40px;
		padding-block-start: 28px;
		border-block-start: 2px solid var(--color-green-800);
	}

	.section-header h2 {
		font-family: var(--font-serif);
		font-size: clamp(2.5rem, 4.4vw, 3.75rem);
		font-weight: 500;
		line-height: 1.05;
		color: var(--color-green-800);
	}

	.section-header p {
		font-size: var(--text-md);
		color: var(--color-text-secondary);
	}

	.section-header a {
		font-weight: 600;
	}

	.no-upcoming {
		font-family: var(--font-serif);
		font-size: var(--text-2xl);
		color: var(--color-green-800);
	}

	.past-events {
		margin-block-start: 64px;
	}

	.past-events h3 {
		margin-block-end: 24px;
		font-family: var(--font-serif);
		font-size: clamp(1.75rem, 2.6vw, 2.25rem);
		font-weight: 500;
		color: var(--color-green-800);
	}
</style>
