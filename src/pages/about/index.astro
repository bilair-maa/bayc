		font-family: var(--font-serif);
		font-size: 2.125rem;
		font-weight: 500;
		line-height: 1.08;
	}

	/* The whole panel is the button's click target. */
	.panel-toggle {
		padding: 0;
		background: none;
		border: 0;
		color: inherit;
		font: inherit;
		text-align: start;
		cursor: pointer;
	}

	.panel-toggle::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.panel-toggle:focus-visible {
		outline: none;
	}

	.panel:has(.panel-toggle:focus-visible) {
		outline: 3px solid var(--color-gold);
		outline-offset: 3px;
	}

	/* Fixed width so the text doesn't reflow while the panel grows. */
	.panel-description {
		inline-size: min(440px, 62vw);
		max-inline-size: 100%;
		font-size: var(--text-lg);
		line-height: 1.6;
		transition:
			opacity 0.35s ease,
			transform 0.45s ease,
			visibility 0.35s;
	}

	[data-interactive] .panel[data-state='expanded'] {
		flex-grow: 2.6;
		background-color: var(--color-gold);
		color: var(--color-ink-on-gold);
	}

	[data-interactive] .panel[data-state='expanded'] .panel-number {
		color: var(--color-ink-on-gold);
	}

	[data-interactive] .panel[data-state='expanded'] .panel-description {
		transition-delay: 0.25s;
	}

	[data-interactive] .panel[data-state='collapsed'] .panel-description {
		visibility: hidden;
		opacity: 0;
		transform: translateY(10px);
	}

	/* Stacked on narrow screens, where there's room to show every description. */
