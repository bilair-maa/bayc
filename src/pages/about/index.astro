---
import Layout from '../../layouts/Layout.astro';
import { founder } from '../../data/leadership';
import { routes } from '../../data/site';

const priorities = [
	{
		id: 'civic-leadership',
		title: 'Civic Leadership',
		description:
			'Developing future civic leaders through mentorship, professional development, and engagement with public institutions.',
	},
	{
		id: 'heritage-advocacy',
		title: 'Heritage Advocacy',
		description:
			'Preserving and celebrating Bengali language, literature, music, arts, and history through community storytelling and public education.',
	},
	{
		id: 'policy-engagement',
		title: 'Policy Engagement',
		description:
			'Strengthening the civic voice of Bangladeshi Americans through engagement with public officials and civic organizations.',
	},
] as const;

const impactStatement =
	'Our civic priorities are designed to empower the next generation of leaders, ensuring that the rich heritage of the Bangladeshi American community is preserved and celebrated through active civic engagement and sustainable advocacy.';
const emphasizedWords = new Set(['empower', 'next', 'generation', 'preserved', 'celebrated']);
const impactWords = impactStatement.split(' ').map((text) => ({
	text,
	emphasized: emphasizedWords.has(text.replace(/[^a-z]/gi, '').toLowerCase()),
}));

const milestones = [
	{
		marker: '1952',
		title: 'The Language Movement',
		description: 'The defense of Bangla as a mother tongue, remembered each year on 21 February.',
	},
	{
		marker: '1971',
		title: 'The Liberation War',
		description:
			'Ideals of freedom, self-determination, and human dignity that BAYC carries forward.',
	},
	{
		marker: 'Today',
		title: 'BAYC',
		description:
			'A new generation of Bangladeshi Americans with a voice in the country we call home.',
	},
] as const;
---

<Layout pageTitle="About">
	<section class="opener" aria-labelledby="about-heading">
		<div class="opener-media" aria-hidden="true">
			<img
				class="opener-bangladesh"
				src="/images/hero-bangladesh-river-boats.jpg"
				alt=""
				width="4032"
				height="2701"
				fetchpriority="high"
			/>
			<img
				class="opener-new-york"
				src="/images/hero-new-york-skyline.jpg"
				alt=""
				width="2576"
				height="1640"
				fetchpriority="high"
			/>
			<div class="opener-tint"></div>
		</div>
		<div class="container opener-content">
			<h1 id="about-heading">About<br />BAYC</h1>
			<p>Founded in New York with a national vision.</p>
		</div>
	</section>

	<section class="container story" aria-label="Mission, vision and legacy">
		<div class="mission">
			<div class="mission-photo">
				<div class="photo-frame" aria-hidden="true"></div>
				<img
					src="/images/hero-bangladesh-rice-fields.jpg"
					alt="Rice paddies and river boats in Bangladesh"
					width="2576"
					height="1932"
					loading="lazy"
				/>
			</div>
			<div class="mission-text">
				<p class="eyebrow">Our Mission</p>
				<h2>BAYC is dedicated to empowering the next generation of Bangladeshi American leaders.</h2>
				<p class="mission-body">
					We bridge heritage and civic engagement, fostering a community that values leadership,
					cultural pride, and active participation in public life.
				</p>
			</div>
		</div>

		<div class="vision">
			<p class="eyebrow">Our Vision</p>
			<p class="vision-statement">
				Our vision is a vibrant, inclusive civic space where youth and professionals unite to shape a
				more equitable future for our community.
			</p>
		</div>

		<div class="legacy">
			<div class="legacy-words" aria-hidden="true">
				<span>Independent</span>
				<span class="legacy-accent">Volunteer-Led</span>
				<span>Heritage &amp; Service</span>
			</div>
			<div class="legacy-text">
				<p class="legacy-kicker">Our Foundation</p>
				<h2>Independent Legacy</h2>
				<p>
					BAYC is an independent, volunteer-led civic association dedicated to fostering leadership
					and civic engagement among Bangladeshi American youth. Founded on the principles of
					heritage and service, we remain a volunteer-driven collective committed to our community's
					growth and public impact.
				</p>
			</div>
		</div>
	</section>

	<section class="priorities-section" aria-labelledby="priorities-heading">
		<div class="container priorities-inner">
			<h2 id="priorities-heading" class="section-title">Our Priorities</h2>
			<ul role="list" class="priorities" data-priorities>
				{
					priorities.map((priority, index) => (
						<li class="panel" data-panel>
							<span class="panel-number" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<div class="panel-body">
								<h3>
									<button
										type="button"
										class="panel-toggle"
										aria-expanded="true"
										aria-controls={`${priority.id}-text`}
									>
										{priority.title}
									</button>
								</h3>
								<p id={`${priority.id}-text`} class="panel-description">
									{priority.description}
								</p>
							</div>
						</li>
					))
				}
			</ul>

			<div class="impact">
				<h3 class="eyebrow">Community Impact</h3>
				<p class="impact-statement" data-reveal>
					<span class="visually-hidden">{impactStatement}</span>
					<span aria-hidden="true">
						{
							impactWords.map((word, index) => (
								<Fragment>
									<span
										class:list={['impact-word', { emphasized: word.emphasized }]}
										style={`--word-index: ${index}`}
									>
										{word.text}
									</span>{' '}
								</Fragment>
							))
						}
					</span>
				</p>
			</div>
		</div>
	</section>

	<section class="container history" aria-labelledby="history-heading">
		<h2 id="history-heading" class="section-title">The History We Carry</h2>
		<ol role="list" class="timeline">
			{
				milestones.map((milestone) => (
					<li class="milestone">
						<span class:list={['milestone-marker', { current: milestone.marker === 'Today' }]}>
							{milestone.marker}
						</span>
						<span class="milestone-title">{milestone.title}</span>
						<span class="milestone-description">{milestone.description}</span>
					</li>
				))
			}
		</ol>
	</section>

	<nav class="next-links" aria-label="More about BAYC">
		<div class="container next-links-inner">
			<a href={routes.founderLetter} class="next-link founder-link">
				<img src={founder.portrait} alt="" width="1024" height="1024" loading="lazy" />
				<span class="next-link-text">
					<span class="next-link-kicker">{founder.name}, {founder.role}</span>
					<span class="next-link-title">
						Read the Founder's Letter <span aria-hidden="true">→</span>
					</span>
				</span>
			</a>
			<a href={routes.leadership} class="next-link leadership-link">
				<span class="next-link-kicker">Leadership Council &amp; Advisory Council</span>
				<span class="next-link-title">Meet Our Leadership <span aria-hidden="true">→</span></span>
			</a>
		</div>
	</nav>
</Layout>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	// Priorities: one panel is expanded at a time; hovering, focusing or
	// clicking a panel expands it. Without JavaScript every panel stays open.
	for (const list of document.querySelectorAll<HTMLElement>('[data-priorities]')) {
		const panels = [...list.querySelectorAll<HTMLElement>('[data-panel]')];
		const toggles = panels.map((panel) => panel.querySelector<HTMLButtonElement>('button'));

		const expand = (index: number) => {
			panels.forEach((panel, i) => {
				const expanded = i === index;
				panel.dataset.state = expanded ? 'expanded' : 'collapsed';
				toggles[i]?.setAttribute('aria-expanded', String(expanded));
			});
		};

		panels.forEach((panel, index) => {
			panel.addEventListener('mouseenter', () => expand(index));
			toggles[index]?.addEventListener('focus', () => expand(index));
			toggles[index]?.addEventListener('click', () => expand(index));
		});

		list.dataset.interactive = '';
		expand(0);
	}

	// Community Impact: the words fade in one by one when the statement scrolls
	// into view. Skipped with reduced motion, and visible from the start if the
	// script never runs.
	if (!reducedMotion.matches && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					(entry.target as HTMLElement).dataset.reveal = 'shown';
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.4 },
		);
		for (const element of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
			element.dataset.reveal = 'waiting';
			observer.observe(element);
		}
	}
</script>

<style>
