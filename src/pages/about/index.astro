			flex-direction: column;
		}

		.panel {
			min-block-size: 170px;
		}

		.panel-description {
			inline-size: auto;
		}

		[data-interactive] .panel[data-state='collapsed'] .panel-description {
			visibility: visible;
			opacity: 1;
			transform: none;
		}
	}

	.impact {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 24px 80px;
		margin-block-start: 72px;
		padding-block-start: 48px;
		border-block-start: 1px solid color-mix(in srgb, var(--color-gold-light) 45%, transparent);
	}

	.impact .eyebrow {
		flex: 0 0 220px;
	}

	.impact-statement {
		flex: 1 1 560px;
		min-inline-size: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.625rem, 2.8vw, 2.375rem);
		line-height: 1.35;
	}

	.impact-word {
		display: inline-block;
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
		transition-delay: calc(200ms + var(--word-index) * 60ms);
	}

	.impact-word.emphasized {
		font-style: italic;
		color: var(--color-gold-light);
	}

	[data-reveal='waiting'] .impact-word {
		opacity: 0;
		transform: translateY(10px);
	}

	@media (prefers-reduced-motion: reduce) {
		.panel,
		.panel-number,
		.panel-description,
		.impact-word {
			transition: none;
		}
	}

	.history {
		padding-block: 112px;
	}

	.history .section-title {
		margin-block-end: 56px;
		color: var(--color-green-800);
	}

	.timeline {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
		gap: 40px 48px;
		border-block-start: 2px solid var(--color-gold);
	}

	.milestone {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding-block-start: 32px;
	}

	/* Square marker sitting on the timeline rule. */
	.milestone::before {
		content: '';
		position: absolute;
		inset-block-start: -9px;
		inset-inline-start: 0;
		inline-size: 16px;
		block-size: 16px;
		background: var(--color-gold);
	}

	.milestone-marker {
		font-family: var(--font-serif);
		font-size: 4rem;
		font-weight: 500;
		line-height: 1;
		color: var(--color-green-800);
	}

	.milestone-marker.current {
		color: var(--color-gold);
	}

	.milestone-title {
		font-family: var(--font-serif);
