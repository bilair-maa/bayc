---
import AdvisorCard from '../components/leadership/AdvisorCard.astro';
import OfficerCard from '../components/leadership/OfficerCard.astro';
import Headshot from '../components/ui/Headshot.astro';
import RichContent from '../components/ui/RichContent.astro';
import Layout from '../layouts/Layout.astro';
import { getLeadership } from '../data/leadership';
import { routes } from '../data/site';

const { founder, officers, advisors } = await getLeadership();

const councilSection = { id: 'council', label: 'Leadership Council' };
const advisorySection = { id: 'advisory', label: 'Strategic Advisory Council' };
const showCouncil = founder !== undefined || officers.length > 0;
const showAdvisory = advisors.length > 0;
const sections = [
	...(showCouncil ? [councilSection] : []),
	...(showAdvisory ? [advisorySection] : []),
];
---

<Layout pageTitle="Leadership">
	<section class="container intro" aria-labelledby="leadership-heading">
		<div class="intro-text">
			<h1 id="leadership-heading" class="page-title">Leadership</h1>
			<p class="lede">
				BAYC is an independent, volunteer-led organization guided by its Leadership Council and
				supported by a Strategic Advisory Council.
			</p>
		</div>
		{
			sections.length > 1 && (
				<nav aria-label="On this page" class="jump-nav">
					<ol role="list">
						{sections.map((section, index) => (
							<li>
								<a href={`#${section.id}`} class="jump-link">
									<span class="jump-number" aria-hidden="true">
										{String(index + 1).padStart(2, '0')}
									</span>
									<span class="jump-label">{section.label}</span>
									<span class="jump-arrow" aria-hidden="true">↓</span>
								</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}
	</section>

	{
		showCouncil && (
			<section id={councilSection.id} class="container council" aria-labelledby="council-heading">
				<h2 id="council-heading" class="group-heading">
					{councilSection.label}
				</h2>

				{founder && (
					<article class="founder">
						<div class="founder-photo">
							<Headshot name={founder.name} photo={founder.photo} initialsSize={96} />
						</div>
						<div class="founder-details">
							{founder.title && <p class="founder-title">{founder.title}</p>}
							<h3>
								{founder.name}
								{founder.city && (
									<>
										<span class="divider" aria-hidden="true">|</span>
										<span class="city">{founder.city}</span>
									</>
								)}
							</h3>
							{founder.bio.length > 0 && <RichContent blocks={founder.bio} />}
							<a href={routes.founderLetter} class="letter-link">
								Read the founder's full message <span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				)}

				{officers.length > 0 && (
					<ul role="list" class="officer-grid">
						{officers.map((officer) => (
							<li>
								<OfficerCard officer={officer} />
							</li>
						))}
					</ul>
				)}
			</section>
		)
	}

	{
		showAdvisory && (
			<section id={advisorySection.id} class="advisory" aria-labelledby="advisory-heading">
				<div class="container advisory-inner">
					<div class="advisory-header">
						<h2 id="advisory-heading">
							Strategic<br />Advisory <em>Council</em>
						</h2>
						<div class="advisory-intro">
							<p class="advisory-statement">
								The Advisory Council serves as the cornerstone of our strategic direction,
								providing expert guidance on civic engagement and heritage preservation.
							</p>
							<p class="advisory-note">
								Our members are dedicated professionals and leaders who ensure that BAYC remains a
								powerful, independent voice for the Bangladeshi American community.
							</p>
						</div>
					</div>
					<ul role="list" class="advisor-grid">
						{advisors.map((advisor) => (
							<li>
								<AdvisorCard advisor={advisor} />
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
</Layout>

<style>
	.intro {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 32px 80px;
		padding-block: 96px 56px;
	}

	.intro-text {
		flex: 999 1 560px;
		display: flex;
		flex-direction: column;
		gap: 22px;
		min-inline-size: 0;
	}

	.lede {
		max-inline-size: 38em;
		font-size: var(--text-xl);
		line-height: var(--leading-body);
	}

	.jump-nav {
		flex: 0 0 auto;
		max-inline-size: 100%;
		padding-inline-start: 28px;
		border-inline-start: 3px solid var(--color-gold);
	}

	.jump-nav ol {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.jump-link {
		display: grid;
		grid-template-columns: 28px auto 28px;
		align-items: baseline;
		column-gap: 14px;
		min-block-size: var(--tap-target);
		padding-block: 10px;
		color: var(--color-green-800);
		text-decoration: none;
	}

	.jump-number {
		font-family: var(--font-serif);
		font-size: var(--text-md);
		font-style: italic;
		color: var(--color-bronze);
	}

	.jump-label {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.15;
		text-decoration: underline;
		text-decoration-color: var(--color-gold);
		text-decoration-thickness: 2px;
		text-underline-offset: 7px;
		transition: color 0.2s ease;
	}

	.jump-arrow {
		justify-self: end;
		font-size: 1.375rem;
		line-height: 1;
		color: var(--color-gold);
		transition: transform 0.25s ease;
	}

	.jump-link:hover .jump-label {
		color: var(--color-green-950);
		text-decoration-thickness: 3px;
	}

	.jump-link:hover .jump-arrow {
		transform: translateY(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.jump-label,
		.jump-arrow {
			transition: none;
		}
	}

	.council {
		padding-block-end: 112px;
	}

	.group-heading {
		padding-block-start: 28px;
		border-block-start: 2px solid var(--color-green-800);
		font-family: var(--font-serif);
		font-size: clamp(2.125rem, 3.4vw, 2.875rem);
		font-weight: 500;
		color: var(--color-green-800);
	}

	.founder {
		display: grid;
		align-items: start;
		gap: 40px 72px;
		margin-block-start: 56px;
		padding-block-end: 64px;
		border-block-end: 1px solid var(--color-rule);
	}

	@media (min-width: 60rem) {
		.founder {
			grid-template-columns: 340px minmax(0, 1fr);
		}
	}

	.founder-photo {
		inline-size: 100%;
		max-inline-size: 340px;
		aspect-ratio: 4 / 5;
	}

	.founder-details {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-inline-size: 36em;
		font-size: var(--text-xl);
		line-height: var(--leading-body);
	}

	.letter-link {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-block-size: var(--tap-target);
		color: var(--color-green-800);
		font-size: var(--text-md);
		font-weight: 600;
		text-decoration-color: var(--color-gold);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.letter-link:hover {
		color: var(--color-green-950);
	}

	.letter-link span {
		color: var(--color-gold);
	}

	.founder-title {
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--color-bronze);
	}

	.founder h3 {
		font-family: var(--font-serif);
		font-size: clamp(2.25rem, 3.6vw, 3.25rem);
		font-weight: 500;
		line-height: 1.05;
		color: var(--color-green-800);
	}

	.divider {
		font-weight: 400;
		color: var(--color-gold);
	}

	.city {
		font-size: 0.55em;
		color: var(--color-text-secondary);
	}

	.officer-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
		gap: 56px 40px;
		padding-block-start: 56px;
	}

	.advisory {
		--headshot-bg: var(--color-placeholder-surface-strong);
		background: var(--color-sand);
	}

	.advisory-inner {
		padding-block: 104px 112px;
	}

	.advisory-header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 28px 88px;
		margin-block-end: 40px;
		padding-block-start: 40px;
		border-block-start: 2px solid var(--color-green-800);
	}

	.advisory-header h2 {
		flex: 1 1 300px;
		font-family: var(--font-serif);
		font-size: clamp(2.75rem, 4.8vw, 4.25rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.015em;
		color: var(--color-green-800);
	}

	.advisory-header em {
		color: var(--color-gold);
	}

	.advisory-intro {
		flex: 999 1 520px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		min-inline-size: 0;
		padding-block-start: 6px;
	}

	.advisory-statement {
		font-family: var(--font-serif);
		font-size: clamp(1.5rem, 2.4vw, 2rem);
		line-height: 1.3;
		color: var(--color-green-800);
	}

	.advisory-note {
		padding-inline-start: 20px;
		border-inline-start: 3px solid var(--color-gold);
		font-size: var(--text-lg);
		line-height: var(--leading-body);
		color: var(--color-text-secondary);
	}

	.advisor-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
		column-gap: 56px;
	}
</style>
